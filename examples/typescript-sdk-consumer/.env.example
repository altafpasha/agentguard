# AgentGuard Security Gateway URL (defaults to http://localhost:3001)
AGENTGUARD_BASE_URL=http://localhost:3001

# AgentGuard API Key with 'evaluate' permission (prefix: ag_live_...)
# Generated from AgentGuard Dashboard -> API Keys
AGENTGUARD_API_KEY=ag_live_your_api_key_here

# Request timeout in milliseconds (default: 10000)
AGENTGUARD_TIMEOUT_MS=10000

# Consumer Application Environment
NODE_ENV=development
