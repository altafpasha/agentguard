# AgentGuard Environment Configuration
# Copy this file to .env for local development:
#   cp .env.example .env
# NEVER commit .env to version control!

# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:54329/agentguard_dev

# OpenRouter AI Provider Configuration
# OpenRouter is used for auxiliary semantic risk scoring and untrusted content analysis.
# (Note: Deterministic Policy Engine is ALWAYS the authoritative final payment authority)
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key-here
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_MS=10000
OPENROUTER_MAX_RETRIES=2
OPENROUTER_MAX_CONTEXT_CHARS=16000
OPENROUTER_RATE_LIMIT_RPM=20

# Whether AI risk analysis is strictly required by policy (if true, unavailable AI causes transactions to fail-closed into HOLD)
POLICY_REQUIRE_AI_RISK_ANALYSIS=false

# PayPal Sandbox Adapter Configuration
# 1. Log in to https://developer.paypal.com/dashboard/applications/sandbox
# 2. Select or create a Sandbox REST App to retrieve Client ID and Secret.
# 3. Credentials are used strictly against https://api-m.sandbox.paypal.com.
# NOTE: Production/Live mode is strictly disabled in AgentGuard.
PAYPAL_CLIENT_ID=your-paypal-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-paypal-sandbox-client-secret
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_API_BASE_URL=https://api-m.sandbox.paypal.com
# Set to true to permit live sandbox order creation and capture calls to PayPal Sandbox API
PAYPAL_ALLOW_LIVE_EXECUTION=false
PAYPAL_TIMEOUT_MS=10000

# Deterministic Policy Engine Configuration
# Maximum amount (in currency units) allowed in a single transaction
POLICY_MAX_TRANSACTION_AMOUNT=50.00
# Maximum rolling daily amount allowed per agent
POLICY_MAX_DAILY_AMOUNT=200.00
# Comma-separated list of allowed ISO currency codes
POLICY_ALLOWED_CURRENCIES=USD,EUR,GBP
# Threshold above which human approval (HITL) token is required
POLICY_REQUIRE_HUMAN_APPROVAL_THRESHOLD=25.00
# Comma-separated list of blocked merchant/recipient emails or domains
POLICY_RECIPIENT_DENYLIST=malicious-merchant@example.com,fraudulent-vendor@example.com
