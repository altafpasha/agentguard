# ==============================================================================
# AgentGuard — Production Self-Hosted Environment Configuration
# ==============================================================================
# Copy this file to .env before starting Docker Compose:
#   cp .env.example .env
#
# IMPORTANT:
# - NEVER commit .env to version control!
# - Ensure secrets (POSTGRES_PASSWORD, PAYPAL_CLIENT_SECRET, etc.) are strong.
# - A fresh installation starts with NO precreated users and NO fake events.
# - Visit http://<YOUR_VPS_IP>:3000/setup to create your initial Owner account.
# ==============================================================================

# --- Container Ports (Host Mapping) ---
DASHBOARD_PORT=3000
GATEWAY_PORT=3001
POSTGRES_PORT=54329

# --- Server & Runtime ---
PORT=3001
HOST=0.0.0.0
NODE_ENV=production
LOG_LEVEL=info

# --- PostgreSQL Database Credentials & Persistence ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_strong_database_password
POSTGRES_DB=agentguard_prod
DATABASE_URL=postgresql://postgres:replace_with_strong_database_password@postgres:5432/agentguard_prod

# --- Clean Self-Hosting vs Demo Seeding ---
# Set to 'false' for production (starts with 0 users, 0 events, requires /setup).
# Set to 'true' only if you want sample demo catalog data seeded.
SEED_DEMO_DATA=false

# --- OpenRouter AI Provider Configuration ---
# OpenRouter is used for auxiliary semantic risk scoring and prompt injection detection.
# (Deterministic Policy Engine is ALWAYS the authoritative final payment authority)
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key-here
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_MS=10000
OPENROUTER_MAX_RETRIES=2
OPENROUTER_MAX_CONTEXT_CHARS=16000
OPENROUTER_RATE_LIMIT_RPM=20

# Whether AI risk analysis is strictly required by policy
# If true and AI is unavailable, high-risk actions fail-closed into HOLD.
POLICY_REQUIRE_AI_RISK_ANALYSIS=false

# --- PayPal Sandbox Adapter Configuration ---
# 1. Log in to https://developer.paypal.com/dashboard/applications/sandbox
# 2. Select or create a Sandbox REST App to retrieve Client ID and Secret.
# 3. Credentials are used strictly against https://api-m.sandbox.paypal.com.
# NOTE: Production live execution is disabled by default for safety.
PAYPAL_CLIENT_ID=your-paypal-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-paypal-sandbox-client-secret
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_API_BASE_URL=https://api-m.sandbox.paypal.com
# Set to true to permit live sandbox order creation and capture calls to PayPal Sandbox API:
PAYPAL_ALLOW_LIVE_EXECUTION=false
PAYPAL_TIMEOUT_MS=10000

# --- Razorpay Payment Gateway Adapter Configuration ---
# 1. Log in to https://dashboard.razorpay.com/app/keys (Test Mode)
# 2. Retrieve your Key ID and Key Secret (rzp_test_...)
# 3. For Webhook signature verification, generate a webhook secret in Razorpay Dashboard.
# NOTE: By default runs in safe simulated mode with zero external charges unless credentials are configured.
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
RAZORPAY_ALLOW_LIVE_EXECUTION=false

# --- Deterministic Policy Engine Defaults ---
# Maximum amount (in currency units) allowed in a single transaction
POLICY_MAX_TRANSACTION_AMOUNT=50.00
# Maximum rolling daily amount allowed per agent
POLICY_MAX_DAILY_AMOUNT=200.00
# Comma-separated list of allowed ISO currency codes
POLICY_ALLOWED_CURRENCIES=USD,EUR,GBP,INR
# Threshold above which human approval (HITL) token is required
POLICY_REQUIRE_HUMAN_APPROVAL_THRESHOLD=25.00
# Comma-separated list of blocked merchant/recipient emails or domains
POLICY_RECIPIENT_DENYLIST=malicious-merchant@example.com,fraudulent-vendor@example.com
